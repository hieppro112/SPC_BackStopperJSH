<controls:MetroWindow
    x:Class="back_stopper.TwoHandDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
    WindowStartupLocation="CenterOwner"
    ShowTitleBar="False"
    ShowCloseButton="False"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Background="Transparent"
    AllowsTransparency="True"
    WindowStyle="None"
    MinWidth="1300"
    Width="1600"
    GlowBrush="Transparent"
    IsManipulationEnabled="True">

    <Border Background="White" CornerRadius="20" Padding="28,24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.2"/>
        </Border.Effect>

        <StackPanel>

            <!-- TITLE -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Width="44" Height="44" CornerRadius="22"
                        Background="#FEF2F2"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0">
                    <TextBlock Text="✋" FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Xác nhận an toàn"
                               FontSize="18" FontWeight="SemiBold" Foreground="#111"/>
                    <TextBlock Text="Giữ đồng thời cả 2 nút để motor chạy"
                               FontSize="12" Foreground="#888" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- DIVIDER -->
            <Border Height="1" Background="#F0F0F0" Margin="0,14,0,16"/>

            <!-- THÔNG TIN PO -->
            <Border Background="#F8FAFC" CornerRadius="10" Padding="14" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎯  " FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txt_po_info"
                               Text="PO: —"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#333" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- TRẠNG THÁI -->
            <Border x:Name="border_status"
                    Background="#F3F4F6"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,0,20">
                <TextBlock x:Name="txt_status"
                           Text="⏸  Chưa sẵn sàng — giữ cả 2 nút bên dưới"
                           FontSize="25" FontWeight="SemiBold"
                           Foreground="#888"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- 2 NÚT GIỮ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- NÚT TRÁI -->
                <Border x:Name="border_left"
                        Grid.Column="0"
                        CornerRadius="14"
                        Background="#F3F4F6">
                    <Button x:Name="btn_left"
                            Height="150"
                            FontSize="18" FontWeight="SemiBold"
                            Foreground="#555"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsManipulationEnabled="True"
                            PreviewMouseLeftButtonDown="btn_left_Down"
                            PreviewMouseLeftButtonUp="btn_left_Up"
                            PreviewTouchDown="btn_left_TouchDown"
                            PreviewTouchUp="btn_left_TouchUp">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👈" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Tay trái" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- NÚT PHẢI -->
                <Border x:Name="border_right"
                        Grid.Column="2"
                        CornerRadius="14"
                        Background="#F3F4F6">
                    <Button x:Name="btn_right"
                            Height="150"
                            FontSize="18" FontWeight="SemiBold"
                            Foreground="#555"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsManipulationEnabled="True"
                            PreviewMouseLeftButtonDown="btn_right_Down"
                            PreviewMouseLeftButtonUp="btn_right_Up"
                            PreviewTouchDown="btn_right_TouchDown"
                            PreviewTouchUp="btn_right_TouchUp">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="👉" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Tay phải" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Border>

            </Grid>

            <!-- DIVIDER -->
            <Border Height="1" Background="#F0F0F0" Margin="0,20,0,16"/>

            <!-- NÚT HỦY -->
            <Button x:Name="btn_cancel"
                    Content="Hủy"
                    Height="44"
                    FontSize="14" FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="btn_cancel_Click"
                    Foreground="#555"
                    Background="#F3F4F6"
                    BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Border>

</controls:MetroWindow>

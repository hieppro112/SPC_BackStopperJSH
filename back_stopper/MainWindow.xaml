<controls:MetroWindow
    x:Class="back_stopper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:local="clr-namespace:back_stopper"
    xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
    mc:Ignorable="d"
    Title="BackStopper"
    WindowStartupLocation="CenterScreen"
    Background="#F3F6FA"
    MinWidth="1300"
    MinHeight="800"
    Width="1600"
    Height="900"
    Icon="Assets/img/ic_app.ico"
    Loaded="MetroWindow_Loaded"
    Closed="MetroWindow_Closed"
    PreviewTextInput="MetroWindow_PreviewTextInput"
    PreviewKeyDown="MetroWindow_PreviewKeyDown"
    WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="RoundBtn" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style x:Key="LabelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Nút bảng điều khiển jog: màu theo Background, mờ đi khi bị khóa (chạm MIN/MAX) -->
        <Style x:Key="JogBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút chọn nhanh khoảng cách mỗi lần nhấn -->
        <Style x:Key="StepChip" TargetType="Button" BasedOn="{StaticResource JogBtn}">
            <Setter Property="Foreground" Value="#4338CA"/>
            <Setter Property="Background" Value="#EEF2FF"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- RIGHT panel: bắt đầu hiện, MinWidth=0 để có thể ẩn hoàn toàn -->
            <ColumnDefinition x:Name="col_right" Width="1*" MinWidth="0"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT ================= -->
        <Grid Grid.Column="0" Margin="0,0,20,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- EMPLOYEE PANEL -->
            <Border Grid.Row="0" IsEnabled="True"
                    x:Name="border_employee"
                    Background="White" CornerRadius="20" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.15"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mã số nhân viên" FontSize="24" FontWeight="SemiBold" Foreground="#222"/>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#F5F7FB" CornerRadius="12" Margin="20,0">
                        <TextBox x:Name="txt_id_employee" InputScope="Number"
                                 Height="45" FontSize="20" BorderThickness="0"
                                 Background="Transparent" Padding="15,0"
                                 VerticalContentAlignment="Center" Foreground="#333"
                                 KeyDown="txt_id_employee_KeyDown"
                                 PreviewMouseLeftButtonDown="txt_id_employee_PreviewMouseLeftButtonDown"
                                 controls:TextBoxHelper.Watermark="Nhập mã số NV tại đây" GotFocus="txt_id_employee_GotFocus" LostFocus="txt_id_employee_LostFocus"/>
                    </Border>

                    <!-- COMBOBOX DÀNH CHO B?N -->
                    <Border Grid.Column="2" Background="#F5F7FB" CornerRadius="12" Margin="0,0,10,0">
                        <ComboBox x:Name="cmb_options" 
                      Height="45" FontSize="18" 
                      BorderThickness="0" 
                      Background="Transparent" 
                      VerticalContentAlignment="Center" 
                      HorizontalContentAlignment="Center"
                      SelectedIndex="1">
                            <ComboBoxItem Content="1"/>
                            <ComboBoxItem Content="1S"/>
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="2S"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="ADM"/>
                        </ComboBox>
                    </Border>

                    <!-- NÚT TOGGLE PANEL -->
                    <Button Grid.Column="3"
                            x:Name="btn_toggle_panel"
                            Click="btn_toggle_panel_Click"
                            Width="42" Height="42"
                            Margin="10,0"
                            Cursor="Hand"
                            ToolTip="Hiện/Ẩn panel điều khiển"
                            Foreground="White"
                            Background="#4F46E5"
                            BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#4338CA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="txt_toggle_icon"
                                   Text="▶"
                                   FontSize="16"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>

                    <TextBlock Grid.Column="4" x:Name="lb_check_emplyee"
                               Text="None" VerticalAlignment="Center" HorizontalAlignment="Center"
                               FontSize="22" FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <!-- MAIN CARD -->
   

            <!-- MAIN CARD -->
            <Border Grid.Row="1" x:Name="border_main"
        Background="White" CornerRadius="20" Padding="30" IsEnabled="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TITLE + NOTIFY -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="BackStopper JSH" FontSize="30" FontWeight="SemiBold"
                       Foreground="#222" Margin="0,0,0,25" Grid.Column="0"/>
                        <TextBlock x:Name="txt_notify" Text= " " FontSize="30" FontWeight="SemiBold"
                       Margin="0,0,0,25" Grid.Column="1" HorizontalAlignment="Right"
                       Foreground="#FFE82828">

                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever"
                                            AutoReverse="True">

                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="1"
                                                To="0.2"
                                                Duration="0:0:0.1"/>        

                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>

                        </TextBlock>
                    </Grid>

                    <!-- SEARCH + BUTTON -->
                    <Grid Grid.Row="1" Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="border_txt_po" Background="#F5F7FB" CornerRadius="12" Margin="0,0,15,0">
                            <TextBox x:Name="txt_po" InputScope="Number"
                         Height="45" FontSize="25" BorderThickness="0"
                         Background="#F5F7FB" Padding="15,0"
                         VerticalContentAlignment="Center" Foreground="#333"
                         KeyDown="txt_po_KeyDown"
                         GotFocus="txt_po_GotFocus"
                         PreviewMouseLeftButtonDown="txt_po_PreviewMouseLeftButtonDown"
                         controls:TextBoxHelper.Watermark="Nhập mã số PO tại đây"/>
                        </Border>
                        <Button x:Name="btn_po_restart"
                    Click="btn_po_restart_Click" Content="Home"
                    Height="45" FontSize="20" FontWeight="SemiBold"
                    Cursor="Hand" Foreground="White" Background="#54D0FA" BorderThickness="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,0,-0.6,0.2" Width="151">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- PRODUCT INFO -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6" Grid.Row="0" Grid.Column="0">
                            <StackPanel>
                                <TextBlock Text="📦" FontSize="20" Margin="0,0,0,4"/>
                                <TextBlock Text="Loại hàng" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_PSTX" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6" Grid.Row="0"  Grid.Column="1">
                            <StackPanel>
                                <TextBlock Text="⚖️" FontSize="20" Margin="0,0,0,4"/>
                                <TextBlock Text="Số lượng" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_gamng" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6" x:Name="border_emg" Grid.Row="1" Grid.Column="0">
                            <StackPanel>
                                <TextBlock Text="⭕" FontSize="25" Margin="0,0,0,4"/>
                                <TextBlock Text="Đường kính" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_d" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6" Grid.Row="1" Grid.Column="1">
                            <StackPanel>
                                <TextBlock Text="📏" FontSize="25" Margin="0,0,0,4"/>
                                <TextBlock Text="Chiều Dài" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_l" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" CornerRadius="14" Padding="14" Margin="6" Grid.Row="0" Grid.Column="2">
                            <StackPanel>
                                <TextBlock Text="🕳️" FontSize="25" Margin="0,0,0,4"/>
                                <TextBlock Text="AirHole" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_airhole" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- SERVO STATUS -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoCard}" Margin="5,70,5,10" Background="#FFFFF1B2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Trạng thái Servo" Style="{StaticResource LabelHeader}" VerticalAlignment="Center" FontSize="18" Grid.Row="0" Foreground="#FF343333" FontWeight="Bold"/>
                                <TextBlock x:Name="txt_status_servo" Grid.Column="1" Grid.Row="1"
                                   Text="Vui lòng, Kết nối servo" FontSize="25" FontWeight="Bold" Foreground="#2563EB">
                                    <TextBlock.Resources>
                                        <Storyboard x:Key="BlinkStoryboard"
                                            RepeatBehavior="Forever"
                                            AutoReverse="True">
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="1"
                                                To="0.3"
                                                Duration="0:0:0.3"/>            
                                        </Storyboard>
                                    </TextBlock.Resources>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <!-- BẢNG ĐIỀU KHIỂN JOG: hiện đè lên 4 ô thông tin sản phẩm sau khi nhập đúng mật khẩu (btn_fab) -->
                        <Border x:Name="panel_jog"
                                Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                                Margin="6" Padding="20" CornerRadius="16"
                                Background="White" BorderBrush="#C7D2FE" BorderThickness="2"
                                Panel.ZIndex="10" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Tiêu đề + vị trí hiện tại -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🎮  Điều khiển và lấy gốc" FontSize="24" FontWeight="SemiBold"
                                               Foreground="#1E1B4B" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#EEF2FF" CornerRadius="10" Padding="14,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Vị trí: " FontSize="18" Foreground="#6B7280" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrenPost}" FontSize="22" FontWeight="Bold"
                                                       Foreground="#4338CA" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Khoảng cách mỗi lần nhấn -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Khoảng cách mỗi lần nhấn (mm)" FontSize="16"
                                                   Foreground="#6B7280" Margin="0,0,0,8"/>
                                        <controls:NumericUpDown
                                            x:Name="num_step"
                                            InputScope="Number"
                                            Value="1" Minimum="0.01" Maximum="10" Interval="0.1"
                                            FontSize="30" FontWeight="SemiBold" Foreground="#4F46E5"
                                            Height="70" BorderThickness="1.5"
                                            controls:TextBoxHelper.Watermark="Step"
                                            ValueChanged="num_step_ValueChanged"
                                            PreviewMouseLeftButtonDown="num_step_PreviewMouseLeftButtonDown"/>
                                        <TextBlock x:Name="txt_step_display" Text="1000" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#4F46E5" Margin="0,8,0,14"/>
                                        <TextBlock Text="Chọn nhanh (mm)" FontSize="14" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                        <UniformGrid Columns="5">
                                            <Button Content="0.1" Tag="0.1" Style="{StaticResource StepChip}" Click="StepPreset_Click"/>
                                            <Button Content="0.5" Tag="0.5" Style="{StaticResource StepChip}" Click="StepPreset_Click"/>
                                            <Button Content="1" Tag="1" Style="{StaticResource StepChip}" Click="StepPreset_Click"/>
                                            <Button Content="2" Tag="2" Style="{StaticResource StepChip}" Click="StepPreset_Click"/>
                                            <Button Content="5" Tag="5" Style="{StaticResource StepChip}" Click="StepPreset_Click"/>
                                        </UniformGrid>
                                    </StackPanel>

                                    <!-- Nút chạy J+ / J- -->
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Button x:Name="btn_start" Content="▲   J+" Click="btn_start_Click"
                                                Style="{StaticResource JogBtn}" Background="#16A34A"
                                                FontSize="30" MinHeight="70"/>
                                        <Button x:Name="btn_Stop" Grid.Row="2" Content="▼   J-" Click="btn_Stop_Click"
                                                Style="{StaticResource JogBtn}" Background="#DC2626"
                                                FontSize="30" MinHeight="70"/>
                                    </Grid>
                                </Grid>

                                <!-- Lấy gốc / đóng bảng -->
                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btn_set_origin" Content="⌖   Xác định gốc" Click="btn_set_origin_Click"
                                            Style="{StaticResource JogBtn}" Background="#0EA5E9"
                                            Height="58" FontSize="22"/>
                                    <Button x:Name="btn_cancel_control" Grid.Column="2" Content="✕   Đóng" Click="btn_cancel_control_Click"
                                            Style="{StaticResource JogBtn}" Background="#6B7280"
                                            Height="58" FontSize="22"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <!-- STOP BUTTON — dưới cùng -->
                    <Button Grid.Row="3"
                x:Name="btn_stop_main"
                Content="⛔  DỪNG KHẨN CẤP"
                Click="btn_stop_main_Click"
                Height="60"
                FontSize="22"
                FontWeight="Bold"
                Cursor="Hand"
                Foreground="White"
                Background="#FFF73030"
                BorderThickness="0"
                Margin="0,16,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#DC2626"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#991B1B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </Grid>
            </Border>
        </Grid>

        <!-- ================= RIGHT ================= -->
        <Border Grid.Column="1"
                x:Name="border_control"
                Background="White"
                CornerRadius="20"
                Padding="18"
                IsEnabled="False"
                Margin="20,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!--<RowDefinition Height="*"/>-->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Điều khiển" FontSize="20" FontWeight="SemiBold"
                               Foreground="#222" VerticalAlignment="Center"/>
                </Grid>

                <!-- SENSORS -->
                <StackPanel Grid.Row="1">
                    <WrapPanel  Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource InfoCard}" MinWidth="85" x:Name="border_ss_min">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelHeader}" Text="Sensor Min" FontSize="20"/>
                                <TextBlock x:Name="txt_ss1" Text="OFF" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}" MinWidth="85" x:Name="border_ss_max">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelHeader}" Text="Sensor Max" FontSize="20"/>
                                <TextBlock x:Name="txt_ss2" Text="OFF" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InfoCard}" MinWidth="85" Background="#FFE2D552" x:Name="border_Relay" MouseLeftButtonDown="Border_MouseLeftButtonDown">
                            <StackPanel >
                                <TextBlock Style="{StaticResource LabelHeader}" Text="Relay" FontSize="20" Foreground="White" FontWeight="Bold"/>
                                <TextBlock x:Name="txt_out_relay" Text="OFF" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <Border Background="#FFAFD7FF" CornerRadius="14" Padding="14" Margin="6" x:Name="border_water">
                            <StackPanel>
                                <Image Source="Assets/img/ic_water.png" Width="25" Height="25" HorizontalAlignment="Left"/>
                                <TextBlock Text="Water" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_status_water" Text="OFF" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>

                            </StackPanel>
                        </Border>
                        <Border Background="#FF8E949B" CornerRadius="14" Margin="6" x:Name="border_drill" Padding="20,20,40,20">
                            <StackPanel>
                                <Image Source="Assets/img/ic_drill.png" Width="25" Height="25" HorizontalAlignment="Left"/>
                                <TextBlock Text="Drill" FontSize="20" Foreground="White"/>
                                <TextBlock x:Name="txt_status_drill" Text="OFF" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
                
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="2">
                    <lvc:CartesianChart Series="{Binding SeriesCollection}" >

                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding Labels}">
                                <lvc:Axis.Separator>
                                    <lvc:Separator Step="1"/>
                                </lvc:Axis.Separator>
                            </lvc:Axis>
                        </lvc:CartesianChart.AxisX>

                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis LabelFormatter="{Binding Formatter}" />
                        </lvc:CartesianChart.AxisY>

                    </lvc:CartesianChart>
                </Grid>


                <!-- SERVO TRAVEL -->
                <Border Grid.Row="3" Style="{StaticResource InfoCard}" Margin="5,0,5,10">
                    <StackPanel>
                        <TextBlock Text="Thông số kỹ thuật servo" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#222" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Vị trí hiện tại" Style="{StaticResource LabelHeader}" VerticalAlignment="Center" FontSize="25"/>
                            <TextBlock x:Name="txt_current_position" Grid.Column="1"
                                       Text="{Binding CurrenPost}" FontSize="25" FontWeight="Bold" Foreground="#222"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!--<TextBlock Text="Vị trí Origin" Style="{StaticResource LabelHeader}" VerticalAlignment="Center" FontSize="25"/>
                            <TextBlock x:Name="txt_origin_pos" Grid.Column="1"
                                       Text="0" FontSize="25" FontWeight="Bold" Foreground="#2563EB"/>-->
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!--<TextBlock Text="Trọng tải" Style="{StaticResource LabelHeader}" VerticalAlignment="Center" FontSize="25"/>
                            <TextBlock x:Name="txt_trongTai" Grid.Column="1"
                                       Text="-" FontSize="25" FontWeight="Bold" Foreground="#2563EB"/>-->
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- MACHINE LOG -->

                <!-- BUTTONS + FAB -->
                <Grid Grid.Row="4" Margin="5,0,5,0">
                    <Grid.ColumnDefinitions>
                        <!--<ColumnDefinition Width="*"/>-->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>



                    <Button x:Name="btn_restart" Grid.Column="1"
                            Content="Clear Log" Click="btn_restart_Click"
                            Style="{StaticResource RoundBtn}"
                            Background="#41C0E8" Margin="0,0,10,0"/>
                    <Button x:Name="btn_done" Grid.Column="0"
                        Content="🚨 Báo cáo sự cố" Click="btn_done_Click"
                        Style="{StaticResource RoundBtn}"
                        Background="#FFF1B54A" Margin="0,0,10,0"/>      



                    <Grid Grid.Column="2" VerticalAlignment="Center">

                        <Button x:Name="btn_fab"
                                Click="btn_fab_Click"
                                
                                Width="120" Height="52"
                                Cursor="Hand" ToolTip="Jog Control"
                                Foreground="White" Background="#4F46E5" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="26">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#4338CA"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#3730A3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Image Source="Assets/img/ic_control.png" Width="25" Height="25"/>
                        </Button>

                    </Grid>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</controls:MetroWindow>

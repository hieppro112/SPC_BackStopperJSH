            <!-- MAIN CARD -->
            <Border Grid.Row="1" x:Name="border_main"
        Background="White" CornerRadius="20" Padding="30" IsEnabled="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TITLE + NOTIFY -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="BackStopper JSH" FontSize="30" FontWeight="SemiBold"
                       Foreground="#222" Margin="0,0,0,25" Grid.Column="0"/>
                        <TextBlock x:Name="txt_notify" Text= " " FontSize="30" FontWeight="SemiBold"
                       Margin="0,0,0,25" Grid.Column="1" HorizontalAlignment="Right"
                       Foreground="#FFE82828">

                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever"
                            AutoReverse="True">

                                            <DoubleAnimation
                        Storyboard.TargetProperty="Opacity"
                        From="1"
                        To="0.2"
                        Duration="0:0:0.1"/>

                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>

                        </TextBlock>
                    </Grid>

                    <!-- SEARCH + BUTTON -->
                    <Grid Grid.Row="1" Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="border_txt_po" Background="#F5F7FB" CornerRadius="12" Margin="0,0,15,0">
                            <TextBox x:Name="txt_po" InputScope="Number"
                         Height="45" FontSize="25" BorderThickness="0"
                         Background="#F5F7FB" Padding="15,0"
                         VerticalContentAlignment="Center" Foreground="#333"
                         KeyDown="txt_po_KeyDown"
                         GotFocus="txt_po_GotFocus"
                         PreviewMouseLeftButtonDown="txt_po_PreviewMouseLeftButtonDown"
                         controls:TextBoxHelper.Watermark="Nhập mã số PO tại đây"/>
                        </Border>
                        <Button x:Name="btn_po_restart"
                    Click="btn_po_restart_Click" Content="Home"
                    Height="45" FontSize="20" FontWeight="SemiBold"
                    Cursor="Hand" Foreground="White" Background="#FF2CD563" BorderThickness="0" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,0,-0.6,0.2" Width="151">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- PRODUCT INFO -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6" Grid.Row="0" Grid.Column="0">
                            <StackPanel>
                                <TextBlock Text="📦" FontSize="20" Margin="0,0,0,4"/>
                                <TextBlock Text="Loại hàng" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_PSTX" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6" Grid.Row="0"  Grid.Column="1">
                            <StackPanel>
                                <TextBlock Text="⚖️" FontSize="20" Margin="0,0,0,4"/>
                                <TextBlock Text="Số lượng" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_gamng" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6" x:Name="border_emg" Grid.Row="1" Grid.Column="0">
                            <StackPanel>
                                <TextBlock Text="⭕" FontSize="25" Margin="0,0,0,4"/>
                                <TextBlock Text="Đường kính" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_d" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6" Grid.Row="1" Grid.Column="1">
                            <StackPanel>
                                <TextBlock Text="📏" FontSize="25" Margin="0,0,0,4"/>
                                <TextBlock Text="Chiều Dài" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_l" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" CornerRadius="14" Padding="14" Margin="6" Grid.Row="0" Grid.Column="2">
                            <StackPanel>
                                <TextBlock Text="🕳️" FontSize="25" Margin="0,0,0,4"/>
                                <TextBlock Text="AirHole" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_airhole" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#16A34A" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- SERVO STATUS -->
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource InfoCard}" Margin="5,70,5,10" Background="#FFFFF1B2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Trạng thái Servo" Style="{StaticResource LabelHeader}" VerticalAlignment="Center" FontSize="18" Grid.Row="0" Foreground="#FF343333" FontWeight="Bold"/>
                                <TextBlock x:Name="txt_status_servo" Grid.Column="1" Grid.Row="1"
                                   Text="Vui lòng, Kết nối servo" FontSize="25" FontWeight="Bold" Foreground="#2563EB">
                                    <TextBlock.Resources>
                                        <Storyboard x:Key="BlinkStoryboard"
                    RepeatBehavior="Forever"
                    AutoReverse="True">

                                            <DoubleAnimation
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0.3"
                Duration="0:0:0.3"/>

                                        </Storyboard>
                                    </TextBlock.Resources>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </Grid>
                    <!-- STOP BUTTON — dưới cùng -->
                    <Button Grid.Row="3"
                x:Name="btn_stop_main"
                Content="⛔  DỪNG KHẨN CẤP"
                Click="btn_stop_main_Click"
                Height="60"
                FontSize="22"
                FontWeight="Bold"
                Cursor="Hand"
                Foreground="White"
                Background="#FFF73030"
                BorderThickness="0"
                Margin="0,16,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#DC2626"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#991B1B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </Grid>
            </Border>
        </Grid>

        <!-- ================= RIGHT ================= -->
        <Border Grid.Column="1"
                x:Name="border_control"
                Background="White"
                CornerRadius="20"
                Padding="18"
                IsEnabled="False"
                Margin="20,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <!--<RowDefinition Height="*"/>-->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Điều khiển" FontSize="20" FontWeight="SemiBold"
                               Foreground="#222" VerticalAlignment="Center"/>
                </Grid>

                <!-- SENSORS -->
                <StackPanel Grid.Row="1">
                    <WrapPanel  Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource InfoCard}" MinWidth="85">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelHeader}" Text="Sensor Min" FontSize="20"/>
                                <TextBlock x:Name="txt_ss1" Text="OFF" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource InfoCard}" MinWidth="85">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LabelHeader}" Text="Sensor Max" FontSize="20"/>
                                <TextBlock x:Name="txt_ss2" Text="OFF" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InfoCard}" MinWidth="85" Background="#FFE2D552" x:Name="border_Relay" MouseLeftButtonDown="Border_MouseLeftButtonDown">
                            <StackPanel >
                                <TextBlock Style="{StaticResource LabelHeader}" Text="Relay" FontSize="20" Foreground="White" FontWeight="Bold"/>
                                <TextBlock x:Name="txt_out_relay" Text="OFF" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>


                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <Border Background="#FFAFD7FF" CornerRadius="14" Padding="14" Margin="6" x:Name="border_water">
                            <StackPanel>
                                <Image Source="Assets/img/ic_water.png" Width="25" Height="25" HorizontalAlignment="Left"/>
                                <TextBlock Text="Water" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_status_water" Text="OFF" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>

                            </StackPanel>
                        </Border>
                        <Border Background="#FF8E949B" CornerRadius="14" Margin="6" x:Name="border_drill" Padding="20,20,40,20">
                            <StackPanel>
                                <Image Source="Assets/img/ic_drill.png" Width="25" Height="25" HorizontalAlignment="Left"/>
                                <TextBlock Text="Drill" FontSize="20" Foreground="White"/>
                                <TextBlock x:Name="txt_status_drill" Text="OFF" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>

                            </StackPanel>
                        </Border>
                    </WrapPanel>

                </StackPanel>


                <!-- SERVO TRAVEL -->
                <Border Grid.Row="2" Style="{StaticResource InfoCard}" Margin="5,0,5,10">
                    <StackPanel>
                        <TextBlock Text="Thông số kỹ thuật servo" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#222" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Vị trí hiện tại" Style="{StaticResource LabelHeader}" VerticalAlignment="Center" FontSize="25"/>
                            <TextBlock x:Name="txt_current_position" Grid.Column="1"
                                       Text="-" FontSize="25" FontWeight="Bold" Foreground="#222"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Vị trí Origin" Style="{StaticResource LabelHeader}" VerticalAlignment="Center" FontSize="25"/>
                            <TextBlock x:Name="txt_origin_pos" Grid.Column="1"
                                       Text="-" FontSize="25" FontWeight="Bold" Foreground="#2563EB"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!--<TextBlock Text="Trọng tải" Style="{StaticResource LabelHeader}" VerticalAlignment="Center" FontSize="25"/>
                            <TextBlock x:Name="txt_trongTai" Grid.Column="1"
                                       Text="-" FontSize="25" FontWeight="Bold" Foreground="#2563EB"/>-->
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- MACHINE LOG -->
                <!--<Border Grid.Row="4" Style="{StaticResource InfoCard}" Margin="5,0,5,10">

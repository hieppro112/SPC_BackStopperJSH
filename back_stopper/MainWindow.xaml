                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>-->

                <!-- BUTTONS + FAB -->
                <Grid Grid.Row="4" Margin="5,0,5,0">
                    <Grid.ColumnDefinitions>
                        <!--<ColumnDefinition Width="*"/>-->
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>



                    <Button x:Name="btn_restart" Grid.Column="0"
                            Content="Clear Log" Click="btn_restart_Click"
                            Style="{StaticResource RoundBtn}"
                            Background="#FFF1B54A" Margin="0,0,10,0"/>

                    <Button x:Name="btn_reconnect" Grid.Column="1"
                            Content="Kết nối lại" Click="btn_reconnect_Click"
                            Style="{StaticResource RoundBtn}"
                            Background="#FF96F14A" Margin="0,0,10,0"/>

                    <Grid Grid.Column="2" VerticalAlignment="Center">
                        <Popup x:Name="popup_jog"
                               StaysOpen="True"
                               AllowsTransparency="True">

                            <Border Background="White" CornerRadius="20" Padding="24"
                                    Width="400" Margin="0,0,0,4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18"/>
                                </Border.Effect>
                                <StackPanel>

                                    <TextBlock Text="Điều khiển và lấy gốc"
                                               FontSize="16" FontWeight="SemiBold"
                                               Foreground="#222" Margin="0,0,0,12"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="khoảng cách/lần" FontSize="13"
                                                   Foreground="#888" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="txt_step_display" Grid.Column="1"
                                                   Text="1000" FontSize="15" FontWeight="Bold" Foreground="#4F46E5"/>
                                    </Grid>

                                    <controls:NumericUpDown
                                        x:Name="num_step"
                                        Value="2" Minimum="0" Maximum="10" Interval="0.1"
                                        FontSize="30" FontWeight="SemiBold" Foreground="#4F46E5"
                                        Height="70" BorderThickness="1.5" Margin="0,0,0,16"
                                        controls:TextBoxHelper.Watermark="Step"
                                        ValueChanged="num_step_ValueChanged"/>

                                    <Border Height="1" Background="#F0F0F0" Margin="0,0,0,14"/>

                                    <Button x:Name="btn_start"
                                            Content="▲   J+" Click="btn_start_Click"
                                            Height="64" FontSize="22" FontWeight="SemiBold"
                                            Foreground="White" Background="#16A34A"
                                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,10">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#15803D"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#14532D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="btn_Stop"
                                            Content="▼   J-" Click="btn_Stop_Click"
                                            Height="64" FontSize="22" FontWeight="SemiBold"
                                            Foreground="White" Background="#DC2626"
                                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#B91C1C"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#991B1B"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Border Height="1" Background="#F0F0F0" Margin="0,14,0,14"/>

                                    <Button x:Name="btn_set_origin"
                                            Content="⌖   Xác định gốc" Click="btn_set_origin_Click"
                                            Height="56" FontSize="20" FontWeight="SemiBold"
                                            Foreground="White" Background="#0EA5E9"
                                            BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#0284C7"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#0369A1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="btn_cancel_control"
                                            Content="Cancel" Click="btn_cancel_control_Click"
                                            Height="64" FontSize="22" FontWeight="SemiBold"
                                            Foreground="White" Background="#FFC5B510"
                                            BorderThickness="0" Cursor="Hand" Margin="0,30,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="12">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#B91C1C"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#991B1B"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                </StackPanel>
                            </Border>
                        </Popup>

                        <Button x:Name="btn_fab"
                                Click="btn_fab_Click"
                                Width="52" Height="52"
                                Cursor="Hand" ToolTip="Jog Control"
                                Foreground="White" Background="#4F46E5" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="26">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#4338CA"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#3730A3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Image Source="Assets/img/ic_control.png" Width="25" Height="25"/>
                        </Button>

                    </Grid>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</controls:MetroWindow>

                            </Button.Template>
                        </Button>
                    </Grid>

                    <UniformGrid Columns="4" Rows="2">
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6">
                            <StackPanel>
                                <TextBlock Text="🔢" FontSize="20" Margin="0,0,0,4"/>
                                <TextBlock Text="AUFNR" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_id" FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6">
                            <StackPanel>
                                <TextBlock Text="📦" FontSize="20" Margin="0,0,0,4"/>
                                <TextBlock Text="PSTX" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_PSTX" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6">
                            <StackPanel>
                                <TextBlock Text="⚖️" FontSize="20" Margin="0,0,0,4"/>
                                <TextBlock Text="GAMNG" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_gamng" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6">
                            <StackPanel>
                                <TextBlock Text="📏" FontSize="25" Margin="0,0,0,4"/>
                                <TextBlock Text="L" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_l" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="14" Padding="14" Margin="6">
                            <StackPanel>
                                <TextBlock Text="⭕" FontSize="25" Margin="0,0,0,4"/>
                                <TextBlock Text="D" FontSize="25" Foreground="#777"/>
                                <TextBlock x:Name="txt_d" Text="..." FontSize="25" FontWeight="SemiBold" Foreground="#222" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" CornerRadius="14" Padding="14" Margin="6">

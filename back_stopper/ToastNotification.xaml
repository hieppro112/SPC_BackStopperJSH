<Window x:Class="back_stopper.ToastNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

    <Border x:Name="border_main" CornerRadius="16"
            MinWidth="480" MaxWidth="600"
            Padding="32,24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" Opacity="0.25" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center">

            <!-- Icon -->
            <TextBlock x:Name="txt_icon"
                       FontSize="48"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <!-- Message -->
            <TextBlock x:Name="txt_message"
                       FontSize="18" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="520"/>

        </StackPanel>
    </Border>
</Window>
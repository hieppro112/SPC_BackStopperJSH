<Window x:Class="back_stopper.NumericKeyboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Nút số thường -->
        <Style x:Key="NumKey" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nút xóa -->
        <Style x:Key="NumKeyDelete" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FECACA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nút Hủy -->
        <Style x:Key="NumKeyCancel" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Nút OK -->
        <Style x:Key="NumKeyOk" TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1D4ED8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>



    <Border CornerRadius="16" Background="White" MouseDown="Border_MouseDown"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.2" ShadowDepth="4"/>
        </Border.Effect>

        <StackPanel Margin="16">

            <!-- Display -->
            <Border CornerRadius="8" Background="#F9FAFB"
                    BorderBrush="#E5E7EB" BorderThickness="1"
                    Margin="0,0,0,12" Padding="12,8">
                <TextBlock x:Name="txt_display"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="#111827"
                           HorizontalAlignment="Right"
                           Text=""/>
            </Border>

            <!-- Buttons Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="100"/>
                </Grid.RowDefinitions>

                <!-- Row 1 -->
                <Button Content="7" Grid.Row="0" Grid.Column="0" Style="{StaticResource NumKey}" Click="NumKey_Click"/>
                <Button Content="8" Grid.Row="0" Grid.Column="1" Style="{StaticResource NumKey}" Click="NumKey_Click"/>
                <Button Content="9" Grid.Row="0" Grid.Column="2" Style="{StaticResource NumKey}" Click="NumKey_Click"/>

                <!-- Row 2 -->
                <Button Content="4" Grid.Row="1" Grid.Column="0" Style="{StaticResource NumKey}" Click="NumKey_Click"/>
                <Button Content="5" Grid.Row="1" Grid.Column="1" Style="{StaticResource NumKey}" Click="NumKey_Click"/>
                <Button Content="6" Grid.Row="1" Grid.Column="2" Style="{StaticResource NumKey}" Click="NumKey_Click"/>

                <!-- Row 3 -->
                <Button Content="1" Grid.Row="2" Grid.Column="0" Style="{StaticResource NumKey}" Click="NumKey_Click"/>
                <Button Content="2" Grid.Row="2" Grid.Column="1" Style="{StaticResource NumKey}" Click="NumKey_Click"/>
                <Button Content="3" Grid.Row="2" Grid.Column="2" Style="{StaticResource NumKey}" Click="NumKey_Click"/>

                <!-- Row 4 -->
                <Button Content="." Grid.Row="3" Grid.Column="0" Style="{StaticResource NumKey}" Click="NumKey_Click"/>
                <Button Content="0" Grid.Row="3" Grid.Column="1" Style="{StaticResource NumKey}" Click="NumKey_Click"/>
                <Button Content="⌫" Grid.Row="3" Grid.Column="2" Style="{StaticResource NumKeyDelete}" Click="Delete_Click"/>

            </Grid>

            <!-- OK + Cancel -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Button Content="Hủy" Grid.Column="0"
                        Style="{StaticResource NumKeyCancel}"
                        Click="Cancel_Click"/>

                <Button Content="OK ✓" Grid.Column="2"
                        Style="{StaticResource NumKeyOk}"
                        Click="Ok_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>